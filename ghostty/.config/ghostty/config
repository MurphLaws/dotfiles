# Font Configuration
font-family = JetBrainsMono Nerd Font Mono
font-style = Bold
font-style-bold = ExtraBold

font-size = 19
font-thicken = true

# Theme — tokyonight storm (match nvim tokyonight-storm)
background = 24283b
foreground = c0caf5
cursor-color = c0caf5
cursor-text = 24283b
selection-background = 2e3c64
selection-foreground = c0caf5

# ANSI palette (tokyonight storm)
palette = 0=#1d202f
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# Window — fullscreen no-nativo: "pantalla completa" es una ventana maximizada
# en el Space actual (no un Space aparte), así QuartoSplit puede dividirla.
macos-non-native-fullscreen = true

# Background with transparency (nvim y tmux heredan esto: nvim usa Normal bg=none
# y en tmux las superficies de chrome usan bg=default, asi que el fondo translucido
# se ve a traves de todo). El blur mantiene el texto legible sobre el escritorio.
background-opacity = 0.97
background-blur = 20

# Background image and shader settings removed — no blur/effects.
# Keeping a single config file and a solid/translucent terminal background.

keybind = shift+enter=text:\x1b\r

# Auto-start tmux
command = /opt/homebrew/bin/tmux new-session -A -s main-$RANDOM
