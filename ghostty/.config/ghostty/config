# Font Configuration
font-family = JetBrainsMono Nerd Font Mono
font-style = Bold
font-style-bold = ExtraBold

font-size = 19
font-thicken = true

# Theme — onedark darker (match nvim onedark.nvim style=darker)
background = 1f2329
foreground = dde1e7
cursor-color = dde1e7
cursor-text = 1f2329
selection-background = 30363f
selection-foreground = dde1e7

# ANSI palette (onedark darker)
palette = 0=#0e1013
palette = 1=#e55561
palette = 2=#8ebd6b
palette = 3=#e2b86b
palette = 4=#4fa6ed
palette = 5=#bf68d9
palette = 6=#48b0bd
palette = 7=#c8cdd5
palette = 8=#767e8c
palette = 9=#e55561
palette = 10=#8ebd6b
palette = 11=#e2b86b
palette = 12=#4fa6ed
palette = 13=#bf68d9
palette = 14=#48b0bd
palette = 15=#f2f4f8

# Window — fullscreen no-nativo: "pantalla completa" es una ventana maximizada
# en el Space actual (no un Space aparte), así QuartoSplit puede dividirla.
macos-non-native-fullscreen = true

# Background with transparency (nvim y tmux heredan esto: nvim usa Normal bg=none
# y en tmux las superficies de chrome usan bg=default, asi que el fondo translucido
# se ve a traves de todo). El blur mantiene el texto legible sobre el escritorio.
background-opacity = 0.95
background-blur = 20

# Background image and shader settings removed — no blur/effects.
# Keeping a single config file and a solid/translucent terminal background.

keybind = shift+enter=text:\x1b\r

# Auto-start tmux
command = /opt/homebrew/bin/tmux new-session -A -s main-$RANDOM
