# Font Configuration
font-family = JetBrainsMono Nerd Font Mono
# Fallback para el glyph del logo Slalom (U+F8000). Ver fonts/slalom/.
font-family = SlalomSymbols
font-style = Bold
font-style-bold = ExtraBold
font-style-italic = Bold Italic
font-style-bold-italic = ExtraBold Italic

font-size = 16
font-thicken = true

# Theme — oxide (match nvim oxidescheme/nvim; valores del port oficial oxidescheme/ghostty)
background = 161616
foreground = cecece
cursor-color = cecece
cursor-text = 161616
selection-background = 2e2e2e
selection-foreground = cecece

# ANSI palette (oxide)
palette = 0=#222222
palette = 1=#ed756e
palette = 2=#5bb661
palette = 3=#c39900
palette = 4=#3ba6f5
palette = 5=#968ff7
palette = 6=#00baaa
palette = 7=#cecece
palette = 8=#808080
palette = 9=#ff9890
palette = 10=#7bd77f
palette = 11=#e3b831
palette = 12=#6fc6ff
palette = 13=#b5b2ff
palette = 14=#00dcca
palette = 15=#eeeeee

# Tamaño inicial de la ventana en celdas (medido del tamaño de uso habitual).
window-width = 191
window-height = 47

# Window — fullscreen no-nativo: "pantalla completa" es una ventana maximizada
# en el Space actual (no un Space aparte), así QuartoSplit puede dividirla.
macos-non-native-fullscreen = true

# Background with transparency (nvim y tmux heredan esto: nvim usa Normal bg=none
# y en tmux las superficies de chrome usan bg=default, asi que el fondo translucido
# se ve a traves de todo). El blur mantiene el texto legible sobre el escritorio.
background-opacity = 0.95
background-blur = 20

# Background image and shader settings removed — no blur/effects.
# Keeping a single config file and a solid/translucent terminal background.

keybind = shift+enter=text:\x1b\r

# Auto-start tmux
command = /opt/homebrew/bin/tmux new-session -A -s main-$RANDOM
