+/// Render the next few tracks of the user's queue inside the playback window
+fn render_up_next(frame: &mut Frame, ui: &UIStateGuard, player: &PlayerState, rect: Rect) {
+    use rspotify::model::PlayableItem;
+    if rect.height < 2 {
+        return;
+    }
+    let Some(queue) = player.queue.as_ref() else {
+        return;
+    };
+    let mut lines = vec![
+        Line::default(),
+        Line::styled("Up next:", Style::default().add_modifier(Modifier::BOLD)),
+    ];
+    for item in queue.queue.iter().take(5) {
+        let (name, artists) = match item {
+            PlayableItem::Track(track) => (
+                track.name.as_str(),
+                track
+                    .artists
+                    .iter()
+                    .map(|a| a.name.as_str())
+                    .collect::<Vec<_>>()
+                    .join(", "),
+            ),
+            PlayableItem::Episode(episode) => {
+                (episode.name.as_str(), episode.show.publisher.clone())
+            }
+            PlayableItem::Unknown(_) => continue,
+        };
+        // mark tracks injected by smart shuffle as radio recommendations
+        let is_radio = match (player.smart_shuffle.as_ref(), item) {
+            (Some(smart), PlayableItem::Track(track)) => track
+                .id
+                .as_ref()
+                .is_some_and(|id| smart.injected.contains(&id.uri())),
+            _ => false,
+        };
+        if is_radio {
+            lines.push(Line::styled(
+                format!("  {} • {artists} ✦ radio", to_bidi_string(name)),
+                ui.theme.page_desc(),
+            ));
+        } else {
+            lines.push(Line::styled(
+                format!("  {} • {artists}", to_bidi_string(name)),
+                ui.theme.playback_metadata(),
+            ));
+        }
+    }
+    frame.render_widget(Paragraph::new(lines), rect);
+}
