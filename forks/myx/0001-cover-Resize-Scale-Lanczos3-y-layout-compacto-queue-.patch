From 6706c1003ca513e45ca380b16a06ecbe2c232e6a Mon Sep 17 00:00:00 2001
From: MurphLaws <nicolaslassojr@gmail.com>
Date: Sun, 26 Jul 2026 22:08:43 -0500
Subject: [PATCH] cover: Resize::Scale(Lanczos3) y layout compacto; queue strip
 persistente bajo la library en todas las vistas

---
 examples/scaletest.rs |  15 ++++
 src/cover.rs          |  29 +++++++-
 src/main.rs           | 163 ++++++++++++++++++++++++++++++++++--------
 3 files changed, 175 insertions(+), 32 deletions(-)
 create mode 100644 examples/scaletest.rs

diff --git a/examples/scaletest.rs b/examples/scaletest.rs
new file mode 100644
index 0000000..006aec3
--- /dev/null
+++ b/examples/scaletest.rs
@@ -0,0 +1,15 @@
+use image::DynamicImage;
+use ratatui::layout::Size;
+use ratatui_image::picker::{Picker, ProtocolType};
+use ratatui_image::Resize;
+use image::imageops::FilterType;
+
+fn main() {
+    let img = DynamicImage::ImageRgb8(image::RgbImage::from_pixel(640, 640, image::Rgb([10, 200, 30])));
+    let mut picker = Picker::from_fontsize(ratatui_image::FontSize::new(24, 53));
+    picker.set_protocol_type(ProtocolType::Kitty);
+    for resize in [Resize::Fit(None), Resize::Scale(Some(FilterType::Lanczos3))] {
+        let p = picker.new_protocol(img.clone(), Size::new(76, 38), resize.clone()).unwrap();
+        println!("{:?} -> rendered cells {:?}", resize, p.size());
+    }
+}
diff --git a/src/cover.rs b/src/cover.rs
index 81af7bd..d2ed382 100644
