@@ -2997,7 +3000,79 @@ fn render(f: &mut Frame, app: &mut App) {
         .spacing(3)
         .split(rows[2]);
 
-    render_library(f, app, theme, body[0]);
+    // Left column: library on top, a persistent queue strip below it in every
+    // view, and (in the Lyrics view) the album art at the bottom at the full
+    // panel width.
+    let full = body[0];
+    let lyrics_art = matches!(app.view, RightView::Lyrics)
+        && app.now.as_ref().is_some_and(|n| n.cover.is_some());
+    let (lib_area, queue_area, art_area) = if lyrics_art {
+        // No library here: just the queue strip on top and the album cover
+        // below, both at the full panel width.
+        let font = app.picker.font_size();
+        let fw = font.width.max(1) as u32;
+        let fh = font.height.max(1) as u32;
+        // Rows needed for a square cover spanning the whole column width.
+        let want_h = ((full.width as u32 * fw + fh - 1) / fh) as u16;
+        let art_h = want_h.min(full.height.saturating_sub(4));
+        let queue_h = full.height.saturating_sub(art_h + 1).max(3);
+        let parts = Layout::vertical([
+            Constraint::Length(queue_h), // queue strip
+            Constraint::Length(1),       // gap
+            Constraint::Length(art_h),   // album art
+        ])
+        .split(full);
+        (None, Some(parts[0]), Some(parts[2]))
+    } else if matches!(app.view, RightView::Queue) {
+        // The right side already shows the full queue — no strip here.
+        (Some(full), None, None)
+    } else {
+        let queue_h: u16 = if full.height >= 24 { 8 } else { 5 };
+        let parts = Layout::vertical([
+            Constraint::Min(6),          // library
+            Constraint::Length(1),       // gap
+            Constraint::Length(queue_h), // queue strip
+        ])
+        .split(full);
+        (Some(parts[0]), Some(parts[2]), None)
+    };
+
+    if let Some(la) = lib_area {
+        render_library(f, app, theme, la);
+    }
+    if let Some(qa) = queue_area {
+        render_queue_strip(f, app, theme, qa);
+    }
+
+    if let Some(slot) = art_area {
+        let font = app.picker.font_size();
+        let fw = font.width.max(1) as u32;
+        let fh = font.height.max(1) as u32;
+        // Exactly as wide as the panel; only narrower if the height cap bit.
+        let uncapped = ((slot.width as u32 * fw + fh - 1) / fh) as u16 <= slot.height;
+        let art_w = if uncapped {
+            slot.width
+        } else {
+            (((slot.height as u32 * fh + fw - 1) / fw) as u16).min(slot.width)
+        };
+        dbglog(&format!(
+            "lyrics art: slot={slot:?} art={art_w}x{} font={fw}x{fh}",
+            slot.height
+        ));
+        if art_w > 0 && slot.height > 0 {
+            // Left-aligned so it lines up with the library panel above.
+            let art_rect = Rect {
+                x: slot.x,
+                y: slot.y,
+                width: art_w,
+                height: slot.height,
+            };
+            if let Some(cover) = app.now.as_mut().and_then(|n| n.cover.as_mut()) {
+                cover.render(f, art_rect);
+            }
+        }
+    }
+
     match app.view {
         RightView::NowPlaying => render_nowplaying_view(f, app, theme, body[1]),
         RightView::Lyrics => render_lyrics(f, app, theme, body[1]),
@@ -3031,6 +3106,51 @@ fn view_tabs<'a>(app: &App, theme: Theme) -> Vec<Span<'a>> {
     spans
 }
 
+/// Append a line to a debug log when MYX_DEBUG is set. Layout diagnostics only.
+fn dbglog(msg: &str) {
+    if std::env::var("MYX_DEBUG").is_err() {
+        return;
+    }
+    use std::io::Write;
+    if let Ok(mut f) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open("/tmp/myx-debug.log")
+    {
+        let _ = writeln!(f, "{msg}");
+    }
+}
+
+/// Compact, always-visible queue strip under the library panel.
+fn render_queue_strip(f: &mut Frame, app: &App, theme: Theme, area: Rect) {
+    f.render_widget(Block::default().style(theme.panel()), area);
+    let inner = area.inner(Margin::new(2, 1));
+    if inner.height < 2 {
+        return;
+    }
+    let max = inner.width as usize;
+    let mut lines: Vec<Line> = vec![Line::from(Span::styled("UP NEXT", theme.heading()))];
+    if app.queue.is_empty() {
+        lines.push(Line::from(Span::styled("queue is empty", theme.muted())));
+    } else {
+        for (i, q) in app
+            .queue
+            .iter()
+            .take(inner.height.saturating_sub(1) as usize)
+            .enumerate()
+        {
+            lines.push(Line::from(vec![
+                Span::styled(format!("{:>2}  ", i + 1), theme.muted()),
+                Span::styled(
+                    truncate(q, max.saturating_sub(4)),
+                    Style::default().fg(theme.text.into()),
+                ),
+            ]));
+        }
+    }
+    f.render_widget(Paragraph::new(lines), inner);
+}
+
 fn render_library(f: &mut Frame, app: &mut App, theme: Theme, area: Rect) {
     f.render_widget(Block::default().style(theme.panel()), area);
     let inner = area.inner(Margin::new(2, 1));
