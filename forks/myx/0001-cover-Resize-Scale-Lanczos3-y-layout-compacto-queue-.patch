 //! The encoded protocol is cached per render area — re-encoding only happens when
 //! the cover box changes size, keeping the render loop cheap.
 
+use image::imageops::FilterType;
 use image::DynamicImage;
 use ratatui::layout::{Rect, Size};
 use ratatui::Frame;
@@ -86,9 +87,33 @@ impl Cover {
         if needs_encode {
             match self
                 .picker
-                .new_protocol(self.img.clone(), Size::new(area.width, area.height), Resize::Fit(None))
+                .new_protocol(
+                    self.img.clone(),
+                    Size::new(area.width, area.height),
+                    Resize::Scale(Some(FilterType::Lanczos3)),
+                )
             {
-                Ok(protocol) => self.cached = Some((area, protocol)),
+                Ok(protocol) => {
+                    if std::env::var("MYX_DEBUG").is_ok() {
+                        use std::io::Write;
+                        if let Ok(mut f) = std::fs::OpenOptions::new()
+                            .create(true)
+                            .append(true)
+                            .open("/tmp/myx-debug.log")
+                        {
+                            let _ = writeln!(
+                                f,
+                                "cover: area={area:?} proto={:?} font={:?} encoded={:?} img={}x{}",
+                                self.picker.protocol_type(),
+                                self.picker.font_size(),
+                                protocol.size(),
+                                self.img.width(),
+                                self.img.height(),
+                            );
+                        }
+                    }
+                    self.cached = Some((area, protocol));
+                }
                 Err(_) => return,
             }
         }
diff --git a/src/main.rs b/src/main.rs
