#!/usr/bin/env bash

NOTE_DIR=${HOME}/.task/notes
mkdir -p "${NOTE_DIR}" "${NOTE_DIR}/projects"

if [[ "$1" == "-p" || "$1" == "--project" ]]; then
    # Project note mode: task note -p <project>
    project="$2"
    if [[ -z "$project" ]]; then
        echo "Usage: task note -p <project>"
        echo "Projects:"
        task _projects
        exit 1
    fi
    nvim "${NOTE_DIR}/projects/${project}.md"
elif [[ $# -eq 1 ]]; then
    # Nota norg en el vault, mismo esquema que las capturas de neorg:
    # ~/notes/task-<slug>.norg con el slug de la descripción.
    uuid=$(task _get $1.uuid)
    title=$(task _get ${uuid}.description)
    slug=$(printf '%s' "$title" | python3 -c '
import re, sys, unicodedata
s = unicodedata.normalize("NFKD", sys.stdin.read()).encode("ascii", "ignore").decode().lower()
print(re.sub(r"[^a-z0-9]+", "-", s).strip("-"))')
    note="${HOME}/notes/task-${slug:-sin-titulo}.norg"
    nvim "$note" || exit 1

    # Marcar el UDA solo si la nota quedó en disco (salir sin guardar = sin nota).
    [ -f "$note" ] && task ${uuid} mod note:$(date +%Y-%m-%dT%H:%M:%S) >/dev/null
else
    nvim ${NOTE_DIR}/buffer
fi
