.DS_Store
__pycache__/

# Secretos: nunca versionar. El real vive solo en ~/.config/zsh/conf.d/secrets.zsh
secrets.zsh
*.local.zsh
graphview-test/

# Copilot local personal instructions (home-only, never commit)
.copilot/copilot-instructions.md

# Taskwarrior local config: never version (machine-specific)
.taskrc

# Juegos: binarios/artefactos de compilación, nunca versionar
games/

# Claude: artefactos de runtime (backups, caché, sesiones, transcripciones),
# nunca versionar. Lo que sí viaja en el repo: CLAUDE.md, settings.json, hooks/
# y skills/. Los plugins se restauran solos desde `enabledPlugins` y
# `extraKnownMarketplaces` de settings.json, así que su caché (~400 MB) sobra.
# Si algún día quieres versionar la memoria automática:
#   git add -f claude/.claude/projects/*/memory
claude/.claude/backups/
claude/.claude/cache/
claude/.claude/plugins/
claude/.claude/projects/
claude/.claude/sessions/
claude/.claude/session-env/
claude/.claude/shell-snapshots/
claude/.claude/telemetry/
claude/.claude/paste-cache/
claude/.claude/image-cache/
claude/.claude/file-history/
claude/.claude/history.jsonl
claude/.claude/policy-limits.json
claude/.claude/mcp-needs-auth-cache.json
claude/.claude/remote-settings.json
claude/.claude/.last-cleanup
claude/.claude/*.bak-*
claude/.claude/daemon/
claude/.claude/daemon.log
claude/.claude/daemon-auth-cooldown
claude/.claude/daemon-auth-status.json
claude/.claude/jobs/
claude/.claude/tasks/
